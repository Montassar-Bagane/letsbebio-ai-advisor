# =============================================================================
# LetsBeBio AI Advisor — Configuration
# =============================================================================

CLIENT_NAME=letsbebio

# -----------------------------------------------------------------------------
# 1. AI Conversational Advisor (Required for /chat)
# -----------------------------------------------------------------------------
ENABLE_INTERPRET=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT=20

# -----------------------------------------------------------------------------
# 2. Storefront & Security
# -----------------------------------------------------------------------------
SITE_URL=https://letsbebio.tn
CORS_ORIGINS=https://letsbebio.tn,https://www.letsbebio.tn
ADMIN_TOKEN=generate_a_random_token_here
RATE_LIMIT_PER_MIN=60

# -----------------------------------------------------------------------------
# 3. Optional: Direct Database Connection
# NOTE: Not required if using the WordPress Plugin "1-Click Direct Sync"
# -----------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=reco_read
# DB_PASSWORD=your_db_password
# DB_NAME=letsbebi
# WP_PREFIX=wp_11e347_
