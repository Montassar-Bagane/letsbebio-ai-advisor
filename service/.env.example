# ---- identity -------------------------------------------------------------
CLIENT_NAME=letsbebio

# ---- WooCommerce database (use a READ-ONLY user) --------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reco_read
DB_PASSWORD=change_me
DB_NAME=wordpress
WP_PREFIX=wp_11e347_

# ---- storefront -----------------------------------------------------------
SITE_URL=https://letsbebio.tn
CORS_ORIGINS=https://letsbebio.tn,https://www.letsbebio.tn

# ---- refresh --------------------------------------------------------------
REBUILD_MINUTES=60
LIVE_STOCK=true

# ---- security -------------------------------------------------------------
ADMIN_TOKEN=generate_a_long_random_string
RATE_LIMIT_PER_MIN=60

# ---- optional: free-text understanding (any OpenAI-compatible provider) ---
# Groq    https://api.groq.com/openai/v1        llama-3.3-70b-versatile   (free)
# Mistral https://api.mistral.ai/v1             mistral-small-latest      (free tier)
# Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#                                               gemini-2.0-flash          (free tier)
# Ollama  http://localhost:11434/v1             llama3.1  (local, no key needed)
ENABLE_INTERPRET=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Providers retire models without notice. If /chat returns a 404,
# run "make models" to see what is available now, then "make set-model".
LLM_TIMEOUT=20

# ---- optional: semantic search --------------------------------------------
# off   : disabled (default) - keyword search only
# local : sentence-transformers, runs offline, free, no API key
#         pip install sentence-transformers numpy
# api   : any OpenAI-compatible /embeddings endpoint (e.g. Mistral)
EMBED_BACKEND=off
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Minimum cosine similarity for a hit. Model-dependent: lower it if
# relevant products are missed, raise it if results look loose.
EMBED_MIN_SCORE=0.15
# EMBED_BASE_URL=https://api.mistral.ai/v1
# EMBED_API_KEY=
